# ========================================================
# Mii Korean Storefront — Environment Variables
# ========================================================

# Supabase (PostgreSQL Database & Realtime / Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudinary (Media Asset CDN & Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=urvaa_unsigned

# Razorpay (Payment Gateway — account must support GBP/international payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (Transactional Email Notifications - Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mii Korean <hello@miikorean.com>

# Application Configuration
CLIENT_URL=http://localhost:5173
PORT=5000