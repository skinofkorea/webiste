# ========================================================
# Skin of Korea — Environment Variables Template
# ========================================================

# --- Supabase (PostgreSQL Database & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Cloudinary (Media Asset CDN & Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Frontend (Vite Client Bundled Variables) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=skinofkorea_unsigned
VITE_SERVER=

# --- Revolut Payment Gateway (UK GBP) ---
# Get your Merchant Secret API Key from Revolut Business -> Merchant -> API
REVOLUT_SECRET_KEY=your_revolut_merchant_secret_key
REVOLUT_MODE=prod
VITE_REVOLUT_MODE=prod

# --- Email Service (Google Workspace / SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@skinofkorea.co.uk
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="Skin of Korea" <support@skinofkorea.co.uk>

# --- Application Configuration ---
CLIENT_URL=https://your-domain.vercel.app
PORT=5000